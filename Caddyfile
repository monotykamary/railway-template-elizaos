{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	handle /healthz {
		rewrite * /health
		reverse_proxy 127.0.0.1:3000 {
			header_up X-API-KEY "{$ELIZA_SERVER_AUTH_TOKEN}"
		}
	}

	handle {
		basic_auth {
			{$BASIC_AUTH_USERNAME} {$BASIC_AUTH_HASH}
		}
		reverse_proxy 127.0.0.1:3000 {
			header_up X-API-KEY "{$ELIZA_SERVER_AUTH_TOKEN}"
		}
	}
}
